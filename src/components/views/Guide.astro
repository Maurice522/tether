---
import JsonLd from '../JsonLd.astro';
import SiteFooter from '../SiteFooter.astro';
import { faqJsonLd } from '../../content/faq';
import { guideBySlug, type Guide } from '../../content/guides';
import { alternatesFor, localePath, translator, type Lang } from '../../i18n';
import Layout from '../../layouts/Layout.astro';

interface Props { lang: Lang; guide: Guide }
const { lang, guide } = Astro.props;
const T = translator(lang);
const path = `/${guide.slug}/`;
const url = new URL(localePath(lang, path), 'https://tethersecure.com').href;
const home = localePath(lang, '/');
const related = guide.related.map((slug) => guideBySlug(lang, slug)).filter((g): g is Guide => !!g);
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Tether', item: new URL(home, 'https://tethersecure.com').href },
    { '@type': 'ListItem', position: 2, name: guide.nav, item: url },
  ],
};
const steps = guide.sections.find((s) => s.steps)?.steps;
const howTo = steps && {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  inLanguage: lang,
  name: T('{task} with Tether', { task: guide.h1.replace(/,$/, '') }),
  totalTime: 'PT1M',
  tool: [{ '@type': 'HowToTool', name: T('A web browser on each device') }],
  step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.text, url: `${url}#step-${i + 1}` })),
};
---
<Layout lang={lang} alternates={alternatesFor(path)} title={guide.title} description={guide.description} ogType="article">
  <Fragment slot="head">
    <JsonLd data={breadcrumb} />
    <JsonLd data={faqJsonLd(guide.faqs, lang)} />
    {howTo && <JsonLd data={howTo} />}
  </Fragment>

  <article class="guide">
    <header class="wrap guide-hero">
      <nav class="crumbs mono" aria-label={T('Breadcrumb')}><a href={home}>Tether</a><span aria-hidden="true">/</span><span>{guide.nav}</span></nav>
      <p class="eyebrow"><span class="live-dot"></span> {guide.kicker}</p>
      <h1>{guide.h1} <span class="serif">{guide.h1Accent}</span></h1>
      <p class="lede">{guide.intro}</p>
      <div class="cta">
        <a class="btn btn-accent btn-lg" href={`${home}?start=1`}>
          {T('Start a session, free')}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <span class="muted cta-note">{T('No install · No sign-up · Encrypted, peer-to-peer')}</span>
      </div>
    </header>

    <div class="wrap guide-body">
      {guide.sections.map((sec) => (
        <section class={sec.steps ? 'steps-block' : ''}>
          <h2>{sec.h2}</h2>
          {sec.paras?.map((p) => <p>{p}</p>)}
          {sec.list && <ul>{sec.list.map((li) => <li>{li}</li>)}</ul>}
          {sec.steps && (
            <ol class="steps">
              {sec.steps.map((st, i) => (
                <li id={`step-${i + 1}`}>
                  <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{st.title}</h3>
                  <p>{st.text}</p>
                </li>
              ))}
            </ol>
          )}
        </section>
      ))}

      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">{T('Questions about {topic}', { topic: lang === 'en' ? guide.nav.toLowerCase() : guide.nav })}</h2>
        {guide.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">{T('More ways to tether')}</h2>
        <div class="related-grid">
          {related.map((r) => (
            <a class="related-card card" href={localePath(lang, `/${r.slug}/`)}>
              <span class="eyebrow">{r.kicker}</span>
              <strong>{r.h1}</strong>
              <span class="muted">{r.description}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>

  <SiteFooter lang={lang} />
</Layout>

<style>
  .guide-hero { padding-block: clamp(28px, 6vh, 64px) 24px; max-width: 900px; }
  .crumbs { display: flex; gap: 8px; font-size: 12px; color: var(--faint); margin-bottom: 22px; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent-text); }
  .live-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); margin-right: 6px; vertical-align: 1px; }
  h1 { margin: 14px 0 18px; font-size: clamp(38px, 5.6vw, 68px); line-height: 0.98; letter-spacing: -0.05em; font-weight: 600; }
  h1 .serif { display: block; color: var(--accent-text); font-size: 1.04em; letter-spacing: -0.03em; }
  .lede { font-size: 18px; color: var(--muted); max-width: 60ch; margin: 0 0 28px; text-wrap: pretty; }
  .cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .cta-note { font-size: 13px; }

  .guide-body { max-width: 760px; padding-bottom: 32px; }
  .guide-body section { padding-block: 26px; border-top: 1px solid var(--line); }
  .guide-body h2 { margin: 0 0 12px; font-size: 26px; letter-spacing: -0.03em; font-weight: 600; line-height: 1.15; }
  .guide-body p, .guide-body li { color: var(--muted); font-size: 16px; line-height: 1.65; }
  .guide-body p { margin: 0 0 12px; }
  .guide-body ul { padding-left: 20px; display: grid; gap: 6px; margin: 0; }

  .steps { list-style: none; padding: 0; margin: 8px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .steps .num { font-size: 12px; color: var(--accent-text); }
  .steps h3 { margin: 4px 0 6px; font-size: 17px; letter-spacing: -0.02em; color: var(--text); }
  .steps p { font-size: 14.5px; margin: 0; }

  .faq details { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .faq summary { cursor: pointer; font-weight: 500; font-size: 16px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--accent-text); font: 500 18px var(--font-mono); transition: rotate 200ms var(--ease-out); }
  .faq details[open] summary::after { rotate: 45deg; }
  .faq details p { margin: 10px 0 0; }

  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 8px; }
  .related-card { display: grid; gap: 6px; padding: 18px; text-decoration: none; border-radius: var(--r); transition: border-color 150ms, transform 200ms var(--ease-out); }
  .related-card:hover { border-color: var(--accent-text); transform: translateY(-2px); }
  .related-card strong { font-size: 16px; letter-spacing: -0.02em; }
  .related-card .muted { font-size: 13px; line-height: 1.5; }

  @media (max-width: 720px) {
    .steps, .related-grid { grid-template-columns: 1fr; }
  }
</style>
