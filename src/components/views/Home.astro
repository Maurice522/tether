---
import JsonLd from '../JsonLd.astro';
import SiteFooter from '../SiteFooter.astro';
import { faqJsonLd, homeFaqs } from '../../content/faq';
import { guides } from '../../content/guides';
import { about, demoSamples } from '../../content/home';
import { alternatesFor, localePath, translator, type Lang } from '../../i18n';
import Layout from '../../layouts/Layout.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = translator(lang);
const faqs = homeFaqs[lang];
const story = about[lang];
const home = localePath(lang, '/');

const SITE = 'https://tethersecure.com';
const app = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Tether',
  alternateName: 'Tether Secure',
  url: SITE + home,
  inLanguage: lang,
  description: T('Free web app to sync your clipboard, send text and securely share files between PCs, Mac and phones. Peer-to-peer, encrypted, no upload, no sign-up.'),
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows, macOS, Linux, ChromeOS, Android, iOS',
  browserRequirements: T('Requires a modern browser with WebRTC (Chrome, Edge, Firefox, Safari).'),
  image: SITE + '/og-image.png',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    T("Sync clipboard between devices"),
    T("Send and receive files up to 500 MB, peer-to-peer"),
    T("Send text and links instantly"),
    T("Connect Windows, Mac, Linux, Android and iPhone"),
    T("Group connection of up to 4 devices"),
    T("Join with a 6-digit code, invite link or QR code"),
    T("End-to-end encrypted WebRTC transfer, no upload"),
  ],
};
const site = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Tether',
  url: SITE + home,
  inLanguage: lang,
};
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Tether',
  url: SITE + '/',
  logo: SITE + '/icon-512.png',
};
---
<Layout lang={lang} alternates={alternatesFor('/')}>
  <Fragment slot="head">
    <JsonLd data={app} />
    <JsonLd data={site} />
    <JsonLd data={org} />
    <JsonLd data={faqJsonLd(faqs, lang)} />
  </Fragment>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>
        <span class="h1-kicker eyebrow"><span class="live-dot"></span> {T("Tether: sync clipboard & share files between 2–4 devices")}</span>
        {T("Copy on one.")}<br /><span class="serif">{T("Paste on the other.")}</span>
      </h1>
      <p class="lede">{T("Link your laptop, your phone, or a friend's machine with a 6-digit code or a QR scan. What you copy on one shows up on the others, and files drop straight across. Browser to browser, nothing uploaded.")}</p>

      <div class="dock card">
        <div class="dock-start">
          <button class="btn btn-accent btn-lg" id="start">
            {T("Start a session")}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <p class="muted small">{T("You get a code and an invite link.")}</p>
        </div>
        <div class="dock-or" aria-hidden="true"><span>{T("or")}</span></div>
        <form class="dock-join" id="join-form" autocomplete="off">
          <label for="otp" class="eyebrow">{T("Join with a code")}</label>
          <div class="otp" data-otp>
            <input id="otp" name="otp" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" aria-label={T("6-digit session code")} />
            <div class="otp-cells" aria-hidden="true">
              {Array.from({ length: 6 }, (_, i) => <span class="cell" data-i={i}></span>)}
            </div>
          </div>
          <button class="btn btn-sm btn-accent icon-btn join-go" type="submit" id="join-btn" aria-label={T("Join")} title={T("Join")}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <p class="join-msg" id="join-msg" role="alert" aria-live="assertive" hidden></p>
        </form>
      </div>
      <ul class="trust" aria-label={T("Privacy at a glance")}>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h14l-3-3M20 16H6l3 3"/></svg>{T("Peer-to-peer")}</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{T("Encrypted")}</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1-.5-8 6 6 0 0 1 11.4-1.5A4.5 4.5 0 0 1 18 18H7z"/><path d="M4 4l16 16"/></svg>{T("No uploads")}</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>{T("No sign-up")}</li>
      </ul>
    </div>

    <div class="stage" aria-hidden="true" data-samples={JSON.stringify(demoSamples[lang])}>
      <div class="device device-a">
        <div class="bar"><i></i><i></i><i></i><span class="mono">Maurice#7F3A</span></div>
        <div class="screen">
          <div class="line w80"></div><div class="line w60"></div>
          <div class="sel mono" data-demo-src>git push origin main</div>
          <div class="line w70"></div><div class="line w40"></div>
        </div>
        <div class="status"><span class="dot on"></span> VS Code</div>
      </div>

      <svg class="cable" data-cable>
        <path data-cable-path />
        <path class="cable-glow" data-cable-path pathLength="100" />
      </svg>
      <div class="packet mono" data-demo-packet>git push origin main</div>

      <div class="device device-b">
        <div class="bar"><i></i><i></i><i></i><span class="mono">Sam#K2QP</span></div>
        <div class="screen">
          <div class="line w50"></div>
          <div class="paste mono" data-demo-dst><span class="caret"></span></div>
          <div class="line w70"></div><div class="line w60"></div>
        </div>
        <div class="status"><span class="eq"><i></i><i></i><i></i></span> Midnight City · M83</div>
      </div>
    </div>
  </section>

  <section class="steps wrap" aria-labelledby="how-title">
    <h2 id="how-title" class="steps-title eyebrow">{T("How to tether your devices")}</h2>
    <article>
      <span class="num mono">01</span>
      <h3>{T("Start")}</h3>
      <p class="muted">{T("Pick a name once and it's remembered. You get a session with a 6-digit code that lasts 10 minutes.")}</p>
    </article>
    <article>
      <span class="num mono">02</span>
      <h3>{T("Link up")}</h3>
      <p class="muted">{T("Read the code out, or send the invite link, which skips the code. Up to 4 people per session.")}</p>
    </article>
    <article>
      <span class="num mono">03</span>
      <h3>{T("Copy, paste, send")}</h3>
      <p class="muted" set:html={T("Copy something and come back to the tab, or press <kbd>Ctrl</kbd><kbd>V</kbd> on the page. It lands on everyone else's clipboard. Drop a file and it goes to them too.")} />
    </article>
  </section>

  <section class="secure wrap" aria-labelledby="secure-title">
    <div class="secure-card">
      <div class="secure-copy">
        <p class="eyebrow">{T("Private by design")}</p>
        <h2 id="secure-title" set:html={T("Nothing sits in <span class=\"serif\">the middle.</span>")} />
        <p class="secure-lede">{T("Tether links your browsers to each other, not to a cloud. Files and clips travel over a direct, encrypted connection, so there's no upload, no copy left on a server, and nothing for anyone to leak later.")}</p>
      </div>

      <figure class="p2p" aria-hidden="true">
        <svg viewBox="0 0 360 200">
          <g class="srv">
            <rect x="150" y="10" width="60" height="44" rx="9" />
            <path d="M162 26h36M162 38h36" />
            <path class="strike" d="M144 6 216 58" />
            <path class="ghost" d="M70 120 C 100 60, 130 40, 150 34 M290 120 C 260 60, 230 40, 210 34" />
          </g>
          <path class="wire" d="M92 140 C 150 172, 210 172, 268 140" />
          <path class="wire-glow" d="M92 140 C 150 172, 210 172, 268 140" pathLength="100" />
          <g class="dev"><rect x="20" y="110" width="72" height="54" rx="10" /><path d="M40 176h32" /></g>
          <g class="dev"><rect x="268" y="110" width="72" height="54" rx="10" /><path d="M288 176h32" /></g>
          <text x="56" y="141">{T("you")}</text>
          <text x="304" y="141">{T("them")}</text>
          <text class="lock" x="180" y="192">{T("encrypted · direct")}</text>
        </svg>
        <figcaption class="mono">{T("no server in the path")}</figcaption>
      </figure>

      <ul class="secure-points">
        <li>
          <h3>{T("Serverless transfer")}</h3>
          <p>{T("Files go straight from your browser to theirs over WebRTC. They're never uploaded, so there's nothing stored to delete.")}</p>
        </li>
        <li>
          <h3>{T("Encrypted on the wire")}</h3>
          <p>{T("Every link is encrypted with DTLS, the same standard behind video calls in your browser. Keys are made fresh for each connection.")}</p>
        </li>
        <li>
          <h3>{T("No accounts")}</h3>
          <p>{T("No email, no password, no profile. Your name lives in a cookie on your own device, and nowhere else.")}</p>
        </li>
        <li>
          <h3>{T("Short-lived by default")}</h3>
          <p>{T("Join codes expire after 10 minutes, rooms hold 4 people at most, and idle sessions vanish after 12 hours.")}</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="about wrap" aria-labelledby="about-title">
    <div class="about-head">
      <p class="eyebrow">{T("About Tether")}</p>
      <h2 id="about-title" set:html={story.title} />
    </div>
    <div class="about-body">
      <p>{story.intro}</p>
      {story.sections.map((sec) => (
        <>
          <h3>{sec.h3}</h3>
          <p>{sec.p}</p>
        </>
      ))}
    </div>
  </section>

  <section class="faq-home wrap" id="faq" aria-labelledby="faq-title">
    <div class="about-head">
      <p class="eyebrow">{T("FAQ")}</p>
      <h2 id="faq-title" set:html={T("Frequently asked <span class=\"serif\">questions.</span>")} />
    </div>
    <div class="faq-list">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="guides wrap" aria-labelledby="guides-title">
    <div class="about-head">
      <p class="eyebrow">{T("Guides")}</p>
      <h2 id="guides-title" set:html={T("More ways to <span class=\"serif\">tether.</span>")} />
    </div>
    <div class="guides-grid">
      {guides[lang].map((g) => (
        <a class="guide-card card" href={localePath(lang, `/${g.slug}/`)}>
          <span class="eyebrow">{g.kicker}</span>
          <strong>{g.h1}</strong>
          <span class="muted">{g.description}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="honest wrap">
    <div class="card honest-card">
      <div>
        <p class="eyebrow">{T("What a browser can and can't do")}</p>
        <h2 set:html={T("No install, so a few <span class=\"serif\">rules apply.</span>")} />
      </div>
      <ul>
        <li set:html={T("<b>Syncing happens when you switch to the tab.</b> Browsers only let a page read your clipboard while it's in front, so switch to Tether after copying and it sends. In Firefox and Safari, press <kbd>Ctrl</kbd><kbd>V</kbd> on the page.")} />
        <li set:html={T("<b>Incoming clips land when you switch to the tab.</b> Everything received also stays in the list, one click to copy.")} />
        <li set:html={T("<b>You set your own status.</b> A website can't see which app you're using, so you pick it: VS Code, Figma, whatever.")} />
        <li set:html={T("<b>Files never touch a server.</b> They need a direct link. Text clips use one too, and only fall back to a relay if a direct link can't be made, where they're deleted after two minutes.")} />
      </ul>
    </div>
  </section>

  <SiteFooter lang={lang} />
</Layout>

<script>
  import { T } from '../../i18n/client';
  import { ensureName } from '../../scripts/identity';
  import { api, membership, toast } from '../../scripts/ui';

  const startBtn = document.getElementById('start') as HTMLButtonElement;
  const form = document.getElementById('join-form') as HTMLFormElement;
  const otpInput = document.getElementById('otp') as HTMLInputElement;
  const cells = [...document.querySelectorAll<HTMLElement>('.otp .cell')];
  const otpBox = document.querySelector<HTMLElement>('[data-otp]')!;

  startBtn.addEventListener('click', async () => {
    try {
      const me = await ensureName({ reason: T('Others in the session will see this name.') });
      startBtn.disabled = true;
      const res = await api('/api/session/create', { body: { name: me.name, tag: me.tag } });
      membership.set(res.sessionId, res.member);
      location.href = `/s/${res.sessionId}`;
    } catch (e: any) {
      startBtn.disabled = false;
      if (e.message !== 'cancelled') toast(e.message, { error: true });
    }
  });

  // Landing pages link to /?start=1: go straight into starting a session (name prompt first if needed).
  if (new URLSearchParams(location.search).has('start')) {
    history.replaceState(null, '', location.pathname);
    startBtn.click();
  }

  function paintOtp() {
    const v = otpInput.value;
    const focused = document.activeElement === otpInput;
    cells.forEach((c, i) => {
      c.textContent = v[i] ?? '';
      c.classList.toggle('filled', !!v[i]);
      c.classList.toggle('active', focused && (i === v.length || (v.length === 6 && i === 5)));
    });
  }
  otpInput.addEventListener('input', () => {
    otpInput.value = otpInput.value.replace(/\D/g, '').slice(0, 6);
    otpBox.classList.remove('shake');
    otpBox.classList.remove('bad');
    if (otpInput.value) joinMsg.hidden = true;
    paintOtp();
    if (otpInput.value.length === 6) form.requestSubmit();
  });
  otpInput.addEventListener('focus', paintOtp);
  otpInput.addEventListener('blur', paintOtp);
  paintOtp();

  const joinMsg = document.getElementById('join-msg')!;
  /** Errors stay put next to the boxes (a toast is gone before you've read it), and the boxes clear for a retry. */
  function joinError(message: string) {
    joinMsg.textContent = message;
    joinMsg.hidden = false;
    otpBox.classList.remove('shake');
    void otpBox.offsetWidth;
    otpBox.classList.add('shake', 'bad');
    otpInput.value = '';
    paintOtp();
    otpInput.focus();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const otp = otpInput.value;
    if (otp.length !== 6) { otpInput.focus(); return; }
    const btn = document.getElementById('join-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.classList.add('busy');
    btn.setAttribute('aria-label', T('Checking…'));
    try {
      // Check the code first, so a typo fails before we ask for a name.
      const info = await api('/api/session/check', { body: { otp } });
      btn.classList.remove('busy');
      btn.setAttribute('aria-label', T('Join'));
      const me = await ensureName({
        reason: info.host ? T("You're joining {host}'s session. They'll see this name.", { host: info.host }) : T('The person who shared the code will see this name.'),
      });
      btn.classList.add('busy');
      btn.setAttribute('aria-label', T('Joining…'));
      const res = await api('/api/session/join', { body: { otp, name: me.name, tag: me.tag } });
      membership.set(res.sessionId, res.member);
      location.href = `/s/${res.sessionId}`;
    } catch (err: any) {
      btn.disabled = false;
      btn.classList.remove('busy');
      btn.setAttribute('aria-label', T('Join'));
      if (err.message === 'cancelled') return;
      joinError(err.message);
    }
  });

  // Hero demo: cycle a few clips through the cable.
  const samples: string[] = JSON.parse(document.querySelector<HTMLElement>('.stage')!.dataset.samples ?? '[]');
  const src = document.querySelector<HTMLElement>('[data-demo-src]')!;
  const packet = document.querySelector<HTMLElement>('[data-demo-packet]')!;
  const dst = document.querySelector<HTMLElement>('[data-demo-dst]')!;
  const stage = document.querySelector<HTMLElement>('.stage')!;
  const cable = document.querySelector<SVGSVGElement>('[data-cable]')!;
  // Route the cable from the copied text on device A to the paste field on device B.
  function layCable() {
    const box = stage.getBoundingClientRect();
    const a = src.getBoundingClientRect();
    const b = dst.getBoundingClientRect();
    const x1 = a.right - box.left + 6, y1 = a.top + a.height / 2 - box.top;
    const x2 = b.left - box.left - 6, y2 = b.top + b.height / 2 - box.top;
    const dx = Math.max(60, Math.abs(x2 - x1) * 0.6);
    const d = `M${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
    cable.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    cable.querySelectorAll('[data-cable-path]').forEach((p) => p.setAttribute('d', d));
    packet.style.offsetPath = `path('${d}')`;
  }
  new ResizeObserver(layCable).observe(stage);

  let i = 0;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function cycle() {
    const text = samples[i++ % samples.length];
    src.textContent = text;
    packet.textContent = text;
    src.classList.remove('copied'); void src.offsetWidth; src.classList.add('copied');
    layCable();
    packet.classList.remove('fly'); void packet.offsetWidth; packet.classList.add('fly');
    cable.classList.remove('firing'); void cable.getBoundingClientRect(); cable.classList.add('firing');
    setTimeout(() => {
      dst.innerHTML = '';
      dst.append(document.createTextNode(text));
      const caret = document.createElement('span'); caret.className = 'caret'; dst.append(caret);
      dst.classList.remove('landed'); void dst.offsetWidth; dst.classList.add('landed');
    }, reduce ? 0 : 1250);
  }
  cycle();
  setInterval(cycle, 3600);
</script>

<style is:global>
  /* Global (but only loaded on home pages): several headings and list items are rendered with set:html,
     which scoped styles cannot reach. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-top: clamp(24px, 6vh, 72px);
    padding-bottom: 72px;
  }
  .live-dot {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow);
    margin-right: 6px; vertical-align: 1px;
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px transparent; } }
  h1 {
    margin: 16px 0 18px;
    font-size: clamp(44px, 6.6vw, 84px);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 600;
  }
  h1 .serif { font-size: 1.1em; letter-spacing: -0.03em; color: var(--accent-text); }
  .lede { font-size: 17px; max-width: 46ch; color: var(--muted); margin: 0 0 32px; text-wrap: pretty; }
  .small { font-size: 13px; margin: 0; }

  .dock {
    display: grid;
    /* The code boxes keep a usable width; longer languages wrap the start column instead. */
    grid-template-columns: auto auto minmax(240px, 1fr);
    align-items: center;
    gap: 22px;
    padding: 18px 18px 18px 22px;
    border-radius: 26px;
    max-width: 620px;
  }
  .dock-start { display: grid; gap: 8px; justify-items: start; }
  .dock-or { align-self: stretch; display: grid; place-items: center; position: relative; }
  .dock-or::before { content: ''; position: absolute; inset: 0 50%; border-left: 1px dashed var(--line-strong); }
  .dock-or span { position: relative; background: var(--surface); padding: 4px 0; font-size: 12px; color: var(--faint); font-family: var(--font-mono); }
  .dock-join { display: grid; grid-template-columns: 1fr auto; gap: 8px 10px; align-items: center; }
  .dock-join label { grid-column: 1 / -1; }

  .otp { position: relative; height: 46px; }
  .otp input {
    position: absolute; inset: 0; width: 100%; opacity: 0; font-size: 16px;
    caret-color: transparent; z-index: 1; cursor: text;
  }
  .otp-cells { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 5px; height: 100%; }
  .cell {
    display: grid; place-items: center;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    font: 500 20px var(--font-mono);
    transition: border-color 150ms, transform 250ms var(--ease-spring), background 150ms;
  }
  .cell.filled { background: var(--surface); border-color: var(--line-strong); animation: pop 260ms var(--ease-spring); }
  .cell.active { border-color: var(--accent-text); box-shadow: 0 0 0 3px var(--accent-glow); }
  .cell.active:empty::after { content: ''; width: 2px; height: 20px; background: var(--accent-text); animation: blink 1s steps(1) infinite; }
  @keyframes pop { from { transform: scale(0.85); } }
  @keyframes blink { 50% { opacity: 0; } }
  .join-go { --h: 46px; }
  .join-go.busy svg { animation: nudge 700ms ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translateX(3px); opacity: 0.5; } }
  .otp.shake { animation: shake 420ms var(--ease-out); }
  .otp.bad .cell { border-color: var(--danger); }
  .join-msg { grid-column: 1 / -1; margin: 0; font-size: 13px; color: var(--danger); }
  @keyframes shake { 20%, 60% { transform: translateX(-6px); } 40%, 80% { transform: translateX(6px); } }

  /* ----------------------------------------------------------- hero stage */
  .stage { position: relative; aspect-ratio: 1.08; min-height: 360px; }
  .device {
    position: absolute;
    width: 58%;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .device-a { top: 2%; left: 0; transform: rotate(-2.5deg); }
  .device-b { bottom: 2%; right: 0; transform: rotate(2deg); }
  .bar { display: flex; align-items: center; gap: 5px; padding: 10px 12px; border-bottom: 1px solid var(--line); font-size: 11px; color: var(--faint); }
  .bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
  .bar span { margin-left: auto; }
  .screen { padding: 16px 14px; display: grid; gap: 9px; }
  .line { height: 7px; border-radius: 4px; background: var(--surface-2); }
