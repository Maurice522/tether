---
import { DEFAULT_LANG, localePath, translator, type Lang } from '../i18n';
import { guides } from '../content/guides';

interface Props { lang?: Lang }
const { lang = DEFAULT_LANG } = Astro.props;
const T = translator(lang);
const home = localePath(lang, '/');
---
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a href={home} class="foot-logo">tether</a>
      <p>{T('Sync your clipboard and share files securely between PCs, Mac and phone. Browser to browser, nothing uploaded.')}</p>
    </div>
    <nav aria-label={T('Ways to use Tether')}>
      <p class="eyebrow">{T('Use Tether to')}</p>
      <ul>
        {guides[lang].map((g) => <li><a href={localePath(lang, `/${g.slug}/`)}>{g.nav}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Tether">
      <p class="eyebrow">Tether</p>
      <ul>
        <li><a href={`${home}?start=1`}>{T('Start a session')}</a></li>
        <li><a href={`${home}#faq`}>{T('FAQ')}</a></li>
        <li><a href={localePath(lang, '/privacy/')}>{T('Privacy & security')}</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap foot-base">
    <span class="mono">© {new Date().getFullYear()} tethersecure.com</span>
    <span>{T('Free · No sign-up · Sessions end after 12 hours of inactivity')}</span>
  </div>
</footer>

<style>
  .site-foot { border-top: 1px solid var(--line); margin-top: 40px; padding-top: 44px; font-size: 14px; }
  .foot-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr)); gap: 32px; }
  .foot-logo { font-weight: 600; font-size: 18px; letter-spacing: -0.03em; text-decoration: none; }
  .foot-brand p { color: var(--muted); max-width: 36ch; margin: 10px 0 0; }
  nav ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 8px; }
  nav a { color: var(--text); text-decoration: none; }
  nav a:hover { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
  .foot-base { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-block: 28px 36px; margin-top: 32px; border-top: 1px solid var(--line); color: var(--faint); font-size: 12.5px; }
  @media (max-width: 720px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }
</style>
