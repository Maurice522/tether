---
import '../styles/global.css';
import { DEFAULT_LANG, LANG_COOKIE, LANG_NAMES, LANGS, OG_LOCALE, translator, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Social card image, relative to the site root. */
  image?: string;
  imageAlt?: string;
  /** Private / utility pages (sessions, share hand-off) stay out of search results. */
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Language of this page. */
  lang?: Lang;
  /**
   * The same page in every language (content pages). Drives hreflang, the switcher links and the
   * redirect to a visitor's chosen language. Pages without it (session rooms) just reload in the new language.
   */
  alternates?: Record<Lang, string>;
}
const SITE = 'https://tethersecure.com';
const {
  lang = DEFAULT_LANG,
  alternates,
  noindex = false,
  ogType = 'website',
  image = '/og-image.png',
} = Astro.props;
const T = translator(lang);
const title = Astro.props.title ?? T('Tether — Sync Clipboard & Securely Share Files Between PCs');
const description = Astro.props.description ?? T('Tether connects your PCs, Mac and phone in seconds. Sync clipboard, send text and share files securely, peer-to-peer and encrypted. No upload, no sign-up, free.');
const imageAlt = Astro.props.imageAlt ?? T('Tether: copy on one device, paste on the other. Clipboard and file sharing, browser to browser.');
const canonical = new URL(Astro.url.pathname, SITE).href;
const imageUrl = new URL(image, SITE).href;
const home = lang === DEFAULT_LANG ? '/' : `/${lang}/`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {alternates && (
      <script is:inline define:vars={{ pageLang: lang, alts: alternates, cookieName: LANG_COOKIE }}>
        // Someone who picked a language with the switcher and lands on an English (unprefixed) page, e.g. from
        // a search result, gets their language. Explicit /de/ or /fr/ links are respected as they are.
        try {
          var m = document.cookie.match(new RegExp('(?:^|; )' + cookieName + '=(en|de|fr)'));
          if (pageLang === 'en' && m && m[1] !== 'en' && alts[m[1]]) location.replace(alts[m[1]] + location.search + location.hash);
        } catch (e) {}
      </script>
    )}
    <!-- Google tag (Tag Manager GTM-TSGKCDZF) -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-TSGKCDZF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="application-name" content="Tether" />
    <meta name="apple-mobile-web-app-title" content="Tether" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Tether" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {alternates && LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#0a0b0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f1ec" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />
    {alternates && !noindex && LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], SITE).href} />)}
    {alternates && !noindex && <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LANG], SITE).href} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@1&display=swap" rel="stylesheet" />
    <slot name="head" />
    <script is:inline>
      try {
        const t = localStorage.getItem('tether:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="topbar wrap">
      <a href={home} class="brand" aria-label={T('Tether home')}>
        <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
          <rect x="2" y="9" width="10" height="14" rx="3.5" fill="currentColor" />
          <rect x="20" y="9" width="10" height="14" rx="3.5" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 16c3-5 5 5 8 0" fill="none" stroke="var(--accent-text)" stroke-width="2.2" stroke-linecap="round" />
        </svg>
        <span>tether</span>
      </a>
      <slot name="center" />
      <div class="topbar-right">
        <div class="lang" data-lang-menu>
          <button class="btn btn-ghost btn-sm lang-btn" type="button" aria-haspopup="true" aria-expanded="false"
                  aria-label={T('Language: {name}', { name: LANG_NAMES[lang] })} data-lang-toggle>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
            <span class="mono">{lang.toUpperCase()}</span>
          </button>
          <ul class="lang-list card" role="menu" hidden data-lang-list>
            {LANGS.map((l) => (
              <li role="none">
                <a role="menuitemradio" aria-checked={l === lang ? 'true' : 'false'} lang={l} hreflang={l}
                   href={alternates ? alternates[l] : Astro.url.pathname} data-set-lang={l}>
                  <span class="mono">{l.toUpperCase()}</span> {LANG_NAMES[l]}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <button class="btn btn-ghost btn-sm id-chip" data-identity data-rename hidden title={T('Change your name')}>
          <span class="avatar" data-identity-avatar></span>
          <span class="who"><span data-identity-name></span><span class="tag" data-identity-tag></span></span>
        </button>
        <button class="btn btn-ghost btn-sm icon-btn" id="theme-toggle" aria-label={T('Toggle theme')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <dialog class="sheet" id="name-gate" aria-labelledby="gate-title">
      <form method="dialog" class="gate">
        <p class="eyebrow">{T('Before you connect')}</p>
        <h2 id="gate-title" set:html={T('What should we <span class="serif">call you?</span>')} />
        <p class="muted" data-reason></p>
        <div class="gate-preview">
          <span class="avatar" data-gate-avatar>?</span>
          <span class="who"><span data-gate-preview>{T('Your name')}</span><span class="tag" data-gate-tag></span></span>
        </div>
        <label class="sr-only" for="gate-name">{T('Name')}</label>
        <input id="gate-name" class="field" name="name" maxlength="24" autocomplete="nickname" placeholder={T('e.g. Maurice')} required />
        <p class="fine muted" set:html={T('Saved in a cookie on this browser only, until you clear it. The <span class="mono">#tag</span> tells devices with the same name apart.')} />
        <div class="gate-actions">
          <button class="btn btn-ghost" value="cancel" formnovalidate>{T('Cancel')}</button>
          <button class="btn btn-accent" type="submit">{T('Continue')}</button>
        </div>
      </form>
    </dialog>

    <script>
      import { LANG_COOKIE } from '../i18n';
      import { T } from '../i18n/client';
      import { ensureName, paintIdentity } from '../scripts/identity';
      paintIdentity();

      // Language switcher: remember the choice (session rooms follow it), then open that version of the page.
      const menu = document.querySelector<HTMLElement>('[data-lang-menu]');
      const toggle = menu?.querySelector<HTMLButtonElement>('[data-lang-toggle]');
      const list = menu?.querySelector<HTMLElement>('[data-lang-list]');
      const setOpen = (open: boolean) => {
        if (!list || !toggle) return;
        list.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
      };
      toggle?.addEventListener('click', () => setOpen(!!list?.hidden));
      document.addEventListener('click', (e) => { if (menu && !menu.contains(e.target as Node)) setOpen(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      menu?.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((a) => a.addEventListener('click', (e) => {
        const secure = location.protocol === 'https:' ? '; Secure' : '';
        document.cookie = `${LANG_COOKIE}=${a.dataset.setLang}; Max-Age=${400 * 86400}; Path=/; SameSite=Lax${secure}`;
        // Same URL in every language (session rooms): the server picks the language, so just reload.
        if (a.getAttribute('href') === location.pathname) { e.preventDefault(); location.reload(); }
      }));

      // Installable app + "Share → Tether" from other apps (see public/sw.js).
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
      document.querySelectorAll('[data-rename]').forEach((b) =>
        b.addEventListener('click', () => ensureName({ force: true, reason: T('Changes apply to sessions you join from now on.') }).catch(() => {})),
      );
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('tether:theme', root.dataset.theme); } catch {}
      });
    </script>

    <style>
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        height: 72px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        text-decoration: none;
        font-weight: 600;
        font-size: 18px;
        letter-spacing: -0.03em;
      }
      .topbar-right { display: flex; align-items: center; gap: 4px; }
      .id-chip { gap: 9px; padding-left: 5px; }
      .id-chip .avatar { width: 26px; height: 26px; border-radius: 8px; font-size: 11px; }
      @media (max-width: 520px) { .id-chip .who .tag { display: none; } }

      .lang { position: relative; }
      .lang-btn { gap: 6px; padding: 0 10px; }
      .lang-btn .mono { font-size: 12px; }
      .lang-list {
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        z-index: 40;
        list-style: none;
        margin: 0;
        padding: 6px;
        min-width: 168px;
        border-radius: 14px;
        animation: sheet-in 220ms var(--ease-spring) both;
      }
      .lang-list a { display: flex; gap: 10px; align-items: center; padding: 9px 10px; border-radius: 9px; text-decoration: none; font-size: 14px; }
      .lang-list a:hover { background: var(--surface-2); }
      .lang-list a[aria-checked="true"] { color: var(--accent-text); }
      .lang-list .mono { font-size: 11.5px; color: var(--faint); width: 20px; }
      @media (max-width: 520px) { .lang-btn .mono { display: none; } .lang-btn { padding: 0; width: 34px; } }

      .gate { padding: 26px; display: grid; gap: 12px; }
      .gate h2 { margin: 0; font-size: 26px; letter-spacing: -0.03em; font-weight: 600; line-height: 1.1; }
      .gate h2 :global(.serif) { font-size: 1.12em; }
      .gate p { margin: 0; }
      .gate-preview {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        margin-top: 6px;
        border-radius: 14px;
        border: 1px dashed var(--line-strong);
        font-size: 17px;
      }
      .gate-preview .empty { color: var(--faint); }
      .fine { font-size: 12.5px; }
      .gate-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 6px; }
    </style>
  </body>
</html>
