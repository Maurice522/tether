---
import Guide from '../../components/views/Guide.astro';
import { allGuides } from '../../content/guides';

export const prerender = true;
export function getStaticPaths() {
  return allGuides('fr').map((guide) => ({ params: { guide: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
---
<Guide lang="fr" guide={guide} />
