---
import Guide from '../components/views/Guide.astro';
import { allGuides } from '../content/guides';

export const prerender = true;
export function getStaticPaths() {
  return allGuides('en').map((guide) => ({ params: { guide: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
---
<Guide lang="en" guide={guide} />
