# Random secret used to hash join codes / member tokens. Local dev: put it in .dev.vars; production: wrangler secret put TETHER_PEPPER. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TETHER_PEPPER=change-me

# Optional: Spotify "now playing" (PKCE, no client secret needed).
# Register redirect URI  <your-origin>/spotify/callback  (use http://127.0.0.1:4327 locally, Spotify rejects "localhost").
PUBLIC_SPOTIFY_CLIENT_ID=

# Optional: TURN relay for strict networks (e.g. Cloudflare Calls / Metered free tier)
PUBLIC_TURN_URL=
PUBLIC_TURN_USERNAME=
PUBLIC_TURN_CREDENTIAL=
