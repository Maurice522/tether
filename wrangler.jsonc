{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tether",
  // Custom entry: exports the Durable Objects and routes WebSockets to them; everything else goes to Astro.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Only the custom domain serves the site; the *.workers.dev address is switched off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tethersecure.com", "custom_domain": true },
    { "pattern": "www.tethersecure.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  // SQLite-backed classes are the ones available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] }]
  // Secret (wrangler secret put): TETHER_PEPPER
}
